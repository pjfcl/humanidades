;; Script Chez Scheme Definitivo para Varredura Recursiva e Geração de Manifesto Duplo com Tags
;; Scriptorium Digital - paulolopes.org
(import (chezscheme))

(define (read-file-string filepath)
  (let ((p (open-input-file filepath)))
    (let loop ((chars '()) (c (read-char p)))
      (if (eof-object? c)
          (begin (close-input-port p) (list->string (reverse chars)))
          (loop (cons c chars) (read-char p))))))

(define (strip-cr s)
  (let* ((len (string-length s))
         (out (open-output-string)))
    (let loop ((i 0))
      (if (= i len)
          (get-output-string out)
          (let ((c (string-ref s i)))
            (if (not (char=? c #\return))
                (write-char c out))
            (loop (+ i 1)))))))

(define (extract-yaml-key content key)
  (let* ((clean-content (strip-cr content))
         (lines (let loop ((str clean-content) (line '()) (acc '()))
                  (if (string=? str "")
                      (reverse (cons (list->string (reverse line)) acc))
                      (let ((c (string-ref str 0))
                            (rest (substring str 1 (string-length str))))
                        (if (char=? c #\newline)
                            (loop rest '() (cons (list->string (reverse line)) acc))
                            (loop rest (cons c line) acc))))))
         (key-prefix (string-append key ":")))
    (let find-val ((lst lines))
      (if (null? lst)
          #f
          (let ((line (string-trim-both (car lst))))
            (if (and (>= (string-length line) (string-length key-prefix))
                     (string=? (substring line 0 (string-length key-prefix)) key-prefix))
                (let* ((val (string-trim-both (substring line (string-length key-prefix) (string-length line))))
                       (len (string-length val)))
                  (cond
                    ((and (> len 1)
                          (or (and (char=? (string-ref val 0) #\") (char=? (string-ref val (- len 1)) #\"))
                              (and (char=? (string-ref val 0) #\') (char=? (string-ref val (- len 1)) #\'))))
                     (substring val 1 (- len 1)))
                    (else val)))
                (find-val (cdr lst))))))))

(define (extract-tags content)
  (let* ((clean-content (strip-cr content))
         (lines (let loop ((str clean-content) (line '()) (acc '()))
                  (if (string=? str "")
                      (reverse (cons (list->string (reverse line)) acc))
                      (let ((c (string-ref str 0))
                            (rest (substring str 1 (string-length str))))
                        (if (char=? c #\newline)
                            (loop rest '() (cons (list->string (reverse line)) acc))
                            (loop rest (cons c line) acc)))))))
    (let parse-lines ((lst lines) (in-tags? #f) (collected '()))
      (if (null? lst)
          (string-join (reverse collected) ", ")
          (let* ((raw-line (car lst))
                 (line (string-trim-both raw-line)))
            (cond
              ((or (and (>= (string-length line) 5) (string=? (substring line 0 5) "tags:"))
                   (and (>= (string-length line) 4) (string=? (substring line 0 4) "tag:")))
               (let* ((prefix-len (if (string=? (substring line 0 5) "tags:") 5 4))
                      (after-colon (string-trim-both (substring line prefix-len (string-length line))))
                      (has-inline? (and (> (string-length after-colon) 0) (not (string=? after-colon "")))))
                 (if has-inline?
                     (parse-lines (cdr lst) #f (cons after-colon collected))
                     (parse-lines (cdr lst) #t collected))))
              ((and in-tags? (> (string-length line) 0) (char=? (string-ref line 0) #\-))
               (let* ((tag-val (string-trim-both (substring line 1 (string-length line))))
                      (clean-tag (let ((len (string-length tag-val)))
                                   (cond
                                     ((and (> len 1)
                                           (or (and (char=? (string-ref tag-val 0) #\") (char=? (string-ref tag-val (- len 1)) #\"))
                                               (and (char=? (string-ref tag-val 0) #\') (char=? (string-ref tag-val (- len 1)) #\'))))
                                      (substring tag-val 1 (- len 1)))
                                     (else tag-val)))))
                 (parse-lines (cdr lst) #t (cons clean-tag collected))))
              ((and in-tags? (not (string=? line "")) (not (char-whitespace? (string-ref raw-line 0))))
               (parse-lines (cdr lst) #f collected))
              (else
               (parse-lines (cdr lst) in-tags? collected)))))))

(define (string-join lst delimiter)
  (if (null? lst)
      ""
      (let loop ((rest (cdr lst)) (acc (car lst)))
        (if (null? rest)
            acc
            (loop (cdr rest) (string-append acc delimiter (car rest)))))))

(define (string-trim-both s)
  (let* ((len (string-length s))
         (start (let loop ((i 0))
                  (if (and (< i len) (char-whitespace? (string-ref s i)))
                      (loop (+ i 1))
                      i)))
         (end (let loop ((i (- len 1)))
                (if (and (>= i start) (char-whitespace? (string-ref s i)))
                    (loop (- i 1))
                    (+ i 1)))))
    (substring s start end)))

(define (scan-directory dir base-section subfolder-name acc)
  (if (file-directory? dir)
      (let ((items (directory-list dir)))
        (let loop ((lst items) (current-acc acc))
          (if (null? lst)
              current-acc
              (let* ((item (car lst))
                     (item-str (if (symbol? item) (symbol->string item) item))
                     (path (string-append dir "/" item-str)))
                (cond
                  ((file-directory? path)
                   (loop (cdr lst) (scan-directory path base-section item-str current-acc)))
                  ((file-regular? path)
                   (let ((len (string-length item-str)))
                     (if (and (> len 3)
                              (string=? (substring item-str (- len 3) len) ".md"))
                         (let* ((slug (substring item-str 0 (- len 3)))
                                (web-path (string-append "/" path)))
                           (if (string=? slug "teste")
                               (loop (cdr lst) current-acc)
                               (let* ((file-content (try-read-file path))
                                      (yaml-cat (and file-content (extract-yaml-key file-content "category")))
                                      (yaml-type (and file-content (extract-yaml-key file-content "type")))
                                      (yaml-tags (and file-content (extract-tags file-content)))
                                      (effective-cat 
                                       (cond
                                         (yaml-cat (string-downcase yaml-cat))
                                         (yaml-type (string-downcase yaml-type))
                                         ((not (string=? subfolder-name "")) (string-downcase subfolder-name))
                                         ((string=? base-section "corpus") "colheita")
                                         (else base-section)))
                                      (effective-tags (if yaml-tags yaml-tags "")))
                                 (begin
                                   (printf "Ficheiro detetado: ~a [sec: ~a, sub: ~a, cat: ~a, tags: ~a]\n" path base-section subfolder-name effective-cat effective-tags)
                                   (loop (cdr lst)
                                         (cons (list
                                                 (cons 'path web-path)
                                                 (cons 'section base-section)
                                                 (cons 'subfolder subfolder-name)
                                                 (cons 'category effective-cat)
                                                 (cons 'tags effective-tags)
                                                 (cons 'slug slug))
                                               current-acc))))))
                         (loop (cdr lst) current-acc))))
                  (else (loop (cdr lst) current-acc)))))))
      acc))

(define (get-unique-categories entries)
  (let loop ((lst entries) (acc '()))
    (if (null? lst)
        (reverse acc)
        (let* ((entry (car lst))
               (cat (cdr (assoc 'category entry))))
          (if (member cat acc)
              (loop (cdr lst) acc)
              (loop (cdr lst) (cons cat acc)))))))

(define (generate-manifest)
  (printf "A iniciar varredura recursiva completa do Scriptorium em Chez Scheme...\n")
  (let ((entries '()))
    (let ((target-sections '("corpus" "oficina" "escola" "sobre")))
      (for-each
        (lambda (sec)
          (let ((dir-path (string-append "md/" sec)))
            (set! entries (scan-directory dir-path sec "" entries))))
        target-sections))

    (let ((sorted-entries
           (sort (lambda (a b)
                   (string>? (cdr (assoc 'slug a)) (cdr (assoc 'slug b))))
                 entries)))

      (call-with-output-file "manifest-all.json"
        (lambda (p)
          (fprintf p "{\n  \"artigos\": [\n")
          (let loop ((lst sorted-entries) (first? #t))
            (if (null? lst)
                #f
                (let ((entry (car lst)))
                  (if (not first?) (fprintf p ",\n") #f)
                  (fprintf p "    {\n      \"path\": ~s,\n      \"section\": ~s,\n      \"subfolder\": ~s,\n      \"category\": ~s,\n      \"tags\": ~s,\n      \"slug\": ~s\n    }"
                           (cdr (assoc 'path entry))
                           (cdr (assoc 'section entry))
                           (cdr (assoc 'subfolder entry))
                           (cdr (assoc 'category entry))
                           (cdr (assoc 'tags entry))
                           (cdr (assoc 'slug entry)))
                  (loop (cdr lst) #f))))
          (fprintf p "\n  ]\n}\n"))
        'replace)
      (printf "manifest-all.json gerado com sucesso!\n")

      (let* ((categories (get-unique-categories sorted-entries))
             (light-entries
              (apply append
                     (map (lambda (cat)
                            (let ((cat-entries (filter (lambda (e) (string=? (cdr (assoc 'category e)) cat)) sorted-entries)))
                              (let take-first ((lst cat-entries) (n 1))
                                (if (or (null? lst) (= n 0))
                                    '()
                                    (cons (car lst) (take-first (cdr lst) (- n 1)))))))
                          categories))))

        (call-with-output-file "manifest.json"
          (lambda (p)
            (fprintf p "{\n  \"artigos\": [\n")
            (let loop ((lst light-entries) (first? #t))
              (if (null? lst)
                  #f
                  (let ((entry (car lst)))
                    (if (not first?) (fprintf p ",\n") #f)
                    (fprintf p "    {\n      \"path\": ~s,\n      \"section\": ~s,\n      \"subfolder\": ~s,\n      \"category\": ~s,\n      \"slug\": ~s\n    }"
                             (cdr (assoc 'path entry))
                             (cdr (assoc 'section entry))
                             (cdr (assoc 'subfolder entry))
                             (cdr (assoc 'category entry))
                             (cdr (assoc 'slug entry)))
                    (loop (cdr lst) #f))))
            (fprintf p "\n  ]\n}\n"))
          'replace)
        (printf "manifest.json leve gerado com sucesso!\n")))))

(define (try-read-file filepath)
  (guard (con [else #f])
    (read-file-string filepath)))

(define (safe-run)
  (guard (con [else (begin (display "Erro fatal na geração dos manifestos.\n") (exit 255))])
    (generate-manifest)))

(safe-run)
